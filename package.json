{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build",
        "dev": "vite",
        "style": "npx prettier . --check",
        "style:fix": "npx prettier . --write",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "typecheck": "vue-tsc --noEmit",
        "check-update": "npx npm-check-updates",
        "update-all": "npx npm-check-updates -u && npm install",
        "update-all-patch": "npx npm-check-updates --target patch -u && npm install",
        "update-playwright": "npm install playwright@latest --dev && npx playwright install"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "@rushstack/eslint-patch": "^1.16",
        "@tailwindcss/vite": "^4.3",
        "@types/node": "^26.6",
        "@vitejs/plugin-vue": "^6.0",
        "@vue/eslint-config-prettier": "^10.2",
        "@vue/eslint-config-typescript": "^14.9",
        "concurrently": "^10.0",
        "eslint": "^10.11",
        "eslint-plugin-vue": "^10.11",
        "laravel-vite-plugin": "^3.2",
        "playwright": "^1.63.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9",
        "prettier-plugin-organize-attributes": "^1.0",
        "prettier-plugin-organize-imports": "^4.3",
        "prettier-plugin-tailwindcss": "^0.8",
        "tailwindcss": "4.3",
        "typescript": "6.0.3",
        "vite": "^8.3",
        "vue": "3.5",
        "vue-tsc": "3.3.11"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.7.1",
        "@lucide/vue": "latest",
        "@sentry/vite-plugin": "^5.4",
        "@sentry/vue": "^10.75",
        "@vueuse/core": "^14.4.0",
        "apexcharts": "^6.10",
        "class-variance-authority": "^0.7",
        "clsx": "^2.1.1",
        "laravel-vue-i18n": "^2.9.0",
        "moment": "^2.31",
        "moment-timezone": "^0.6",
        "reka-ui": "^2.10",
        "tailwind-merge": "^3.7",
        "tailwindcss-animate": "^1.0",
        "tw-animate-css": "^1.4",
        "vaul-vue": "^0.4",
        "vue3-apexcharts": "^1.11",
        "vue3-emoji-picker": "^1.1",
        "vuedraggable": "^4.1.0"
    }
}
